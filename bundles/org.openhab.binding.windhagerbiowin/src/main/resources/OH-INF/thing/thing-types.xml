<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="windhagerbiowin"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="WindhagerBioWinHandler" extensible="BioWinChannel">
		<label>Windhager BioWin Webserver</label>
		<description>A connection to a Windhager BioWin Webserver</description>

		<config-description>
			<parameter name="host" type="text" required="true">
				<label>Webserver Hostname/IP</label>
				<description>The IP/Hostname of the BioWin Webserver</description>
				<context>network-address</context>
				<default>bennibus.fritz.box</default>
			</parameter>

			<parameter name="port" type="integer">
				<label>Webserver Port</label>
				<description>The port is optional, if none is provided, the typical
					port 80 is used.</description>
				<context>network-address</context>
				<advanced>true</advanced>
				<default>8080</default>
			</parameter>

			<parameter name="username" type="text" required="true">
				<label>Username</label>
				<description>The Webserver username</description>
				<default>User</default>
			</parameter>

			<parameter name="password" type="text" required="true">
				<label>Password</label>
				<description>The Webserver password</description>
				<context>password</context>
				<default>testPasswort</default>
			</parameter>
		</config-description>
	</thing-type>

	<channel-type id="BioWinChannel">
		<kind>trigger</kind>
		<label>Publish Trigger</label>
		<description>This channel is triggered when a value is published to the configured MQTT topic on this broker
			connection. The event payload will be the received MQTT topic value.</description>
		<event></event>
		<config-description>
			<parameter name="OID" type="text" required="true">
				<label>OID of the value to be polled</label>
				<description></description>
			</parameter>
			<parameter name="refreshIntervall" type="integer" required="false">
				<label>Update interval in seconds</label>
				<description></description>
			</parameter>
		</config-description>
	</channel-type>
</thing:thing-descriptions>
